NODE_ENV=development
PORT=3000
INSTANCE_ID=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/jewelry_saas?schema=public&connection_limit=5&pool_timeout=10
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379
GOLD_RATE_CACHE_TTL_SECONDS=600
RABBITMQ_URL=amqp://jewelry:change-me-local@127.0.0.1:5672
RABBITMQ_DEFAULT_USER=jewelry
RABBITMQ_DEFAULT_PASS=change-me-local
RABBITMQ_CONNECT_TIMEOUT_MS=2000
INVOICE_PDF_STORAGE_PATH=./storage/invoices
INVOICE_PDF_MAX_ATTEMPTS=3
INVOICE_PDF_RETRY_DELAY_MS=5000
INVOICE_WORKER_PREFETCH=1
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.local
SUPER_ADMIN_PASSWORD=change-me
