NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/jewelry_saas?schema=public&connection_limit=10&pool_timeout=10
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://redis:6379
GOLD_RATE_CACHE_TTL_SECONDS=600
RABBITMQ_URL=amqp://jewelry:change-me-local@rabbitmq:5672
RABBITMQ_DEFAULT_USER=jewelry
RABBITMQ_DEFAULT_PASS=change-me-local
RABBITMQ_CONNECT_TIMEOUT_MS=2000
INVOICE_PDF_STORAGE_PATH=/app/storage/invoices
INVOICE_PDF_MAX_ATTEMPTS=3
INVOICE_PDF_RETRY_DELAY_MS=5000
INVOICE_WORKER_PREFETCH=1
